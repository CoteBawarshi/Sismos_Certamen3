# Copiar este archivo como .env y completar los valores. El .env NO se sube a GitHub.
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
DJANGO_DEBUG=False
# IP pública o DNS de la instancia EC2, separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,TU_IP_PUBLICA_EC2
# Ruta de la base de datos SQLite en el servidor (opcional)
SQLITE_PATH=/home/ubuntu/Sismos_en_el_ultimo_siglo/db.sqlite3
